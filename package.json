{
  "name": "wubrgr",
  "private": true,
  "version": "0.1.0",
  "description": "A Magic: The Gathering card binder app: keep your cards in binders that look and work like real ones, find any card with the MTG Card Finder, and save everything to your own Google Drive (or just on your device).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navypirate83/WUBRGr.git"
  },
  "homepage": "https://navypirate83.github.io/WUBRGr/",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
